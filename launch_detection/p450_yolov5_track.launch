<launch>
    <node pkg="prometheus_detection" type="web_cam" name="web_cam" output="screen" launch-prefix="gnome-terminal --tab --" >
        <param name="camera_type" type="int" value="3" />
        <param name="cam_id" type="int" value="0" />
        <!-- 发布到ros图像话题 -->
        <param name="adv_topic" type="string" value="/prometheus/sensor/monocular_front/image_raw" />
	    <param name="resize_h" type="int" value="480" />
        <param name="resize_w" type="int" value="640" />
    </node>

	<node pkg="prometheus_detection" type="yolov5_tensorrt_client.py" name="yolov5_client" output="screen" >
		<param name="camera_parameters" type="string" value="$(find prometheus_gazebo)/config/camera_config/gimbal_camera.yaml" />
		<param name="pub_track_topic" type="string" value="/prometheus/object_detection/siamrpn_tracker" />
		<param name="uav_id" type="int" value="1" />
	</node>

    <node pkg="prometheus_detection" type="gstreamer_rtsp_stream.py" name="gstreamer_rtsp_stream" output="screen" launch-prefix="gnome-terminal --tab --">
        <param name="camera_topic" value="/uav1/prometheus/object_detection/siamrpn_tracker/detection"/>
        <param name="config_info" value="$(find prometheus_detection)/py_nodes/rtsp_stream/encode_config.yaml"/>
    </node>


</launch>